@model InmobiliariaGrupoNN.Models.Pago
@{ ViewData["Title"] = "Detalle del Pago"; }
<h2 class="mb-4">Detalles del Pago #@Model.Id</h2>
<div class="card shadow-sm">
    <div class="card-header bg-dark text-white">Información del pago</div>
    <div class="card-body"><dl class="row mb-0">
        <dt class="col-sm-3">Id</dt><dd class="col-sm-9">@Model.Id</dd>
        <dt class="col-sm-3">Reserva</dt><dd class="col-sm-9"><a asp-controller="Reservas" asp-action="Details" asp-route-id="@Model.ReservaId">#@Model.ReservaId</a> — @Model.Reserva?.Inmueble?.Direccion</dd>
        <dt class="col-sm-3">Concepto</dt><dd class="col-sm-9">@Model.Concepto</dd>
        <dt class="col-sm-3">Fecha del pago</dt><dd class="col-sm-9">@Model.FechaPago.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-3">Importe</dt><dd class="col-sm-9">$ @Model.Importe.ToString("N2")</dd>
        <dt class="col-sm-3">Estado</dt><dd class="col-sm-9"><span class="badge @(Model.EstadoActivo ? "bg-success" : "bg-danger")">@(Model.EstadoActivo ? "Activo" : "Anulado")</span></dd>
        @if (Model.FechaAnulacion.HasValue)
        {
            <dt class="col-sm-3">Fecha de anulación</dt><dd class="col-sm-9">@Model.FechaAnulacion.Value.ToString("dd/MM/yyyy HH:mm:ss")</dd>
        }
    </dl></div>
</div>
<div class="mt-3">
    @if (Model.EstadoActivo)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar concepto</a>
        <a asp-action="Anular" asp-route-id="@Model.Id" class="btn btn-danger">Anular</a>
    }
    <a asp-action="Index" asp-route-reservaId="@Model.ReservaId" class="btn btn-secondary">Volver a Pagos</a>
</div>
