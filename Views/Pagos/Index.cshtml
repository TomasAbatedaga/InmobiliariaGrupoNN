@model IList<InmobiliariaGrupoNN.Models.Pago>
@{
    ViewData["Title"] = "Pagos de la Reserva";
    var reserva = (InmobiliariaGrupoNN.Models.Reserva)ViewBag.Reserva;
    int pagina = ViewBag.PaginaActual;
    int tamanio = ViewBag.TamanioPagina;
    int paginas = ViewBag.TotalPaginas;
}
<h2 class="mb-4">Pagos de la Reserva #@reserva.Id</h2>
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <p class="mb-1"><strong>Inmueble:</strong> @reserva.Inmueble?.Direccion</p>
        <p class="mb-1"><strong>Inquilino:</strong> @reserva.Inquilino?.Nombre @reserva.Inquilino?.Apellido</p>
        <p class="mb-0"><strong>Período:</strong> @reserva.FechaInicio.ToString("dd/MM/yyyy") al @reserva.FechaFin.ToString("dd/MM/yyyy")</p>
    </div>
</div>
@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <a asp-action="Create" asp-route-reservaId="@reserva.Id" class="btn btn-primary">Nuevo Pago</a>
        <a asp-controller="Reservas" asp-action="Details" asp-route-id="@reserva.Id" class="btn btn-secondary">Volver a la Reserva</a>
    </div>
    <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
        <input type="hidden" name="reservaId" value="@reserva.Id" />
        <input type="hidden" name="pagina" value="1" />
        <label for="tamanio">Mostrar:</label>
        <select id="tamanio" name="tamanio" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
            @if (tamanio == 5)
            {
                <option value="5" selected="selected">5 filas</option>
            }
            else
            {
                <option value="5">5 filas</option>
            }
            @if (tamanio == 10)
            {
                <option value="10" selected="selected">10 filas</option>
            }
            else
            {
                <option value="10">10 filas</option>
            }
            @if (tamanio == 20)
            {
                <option value="20" selected="selected">20 filas</option>
            }
            else
            {
                <option value="20">20 filas</option>
            }
        </select>
        <button type="submit" class="btn btn-outline-secondary btn-sm">Aplicar</button>
    </form>
</div>
<div class="table-responsive">
    <table class="table table-striped table-hover border">
        <thead class="table-dark"><tr><th>Concepto</th><th>Fecha</th><th>Importe</th><th>Estado</th><th>Acciones</th></tr></thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" class="text-center text-muted">Esta reserva todavía no tiene pagos.</td></tr>
        }
        @foreach (var pago in Model)
        {
            <tr>
                <td>@pago.Concepto</td>
                <td>@pago.FechaPago.ToString("dd/MM/yyyy")</td>
                <td>$ @pago.Importe.ToString("N2")</td>
                <td><span class="badge @(pago.EstadoActivo ? "bg-success" : "bg-danger")">@(pago.EstadoActivo ? "Activo" : "Anulado")</span></td>
                <td>
                    <a asp-action="Details" asp-route-id="@pago.Id" class="btn btn-info btn-sm">Detalles</a>
                    @if (pago.EstadoActivo)
                    {
                        <a asp-action="Edit" asp-route-id="@pago.Id" class="btn btn-warning btn-sm">Editar concepto</a>
                        <a asp-action="Anular" asp-route-id="@pago.Id" class="btn btn-danger btn-sm">Anular</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted">Página @pagina de @paginas — @ViewBag.TotalRegistros pagos</span>
    <nav aria-label="Páginas de pagos">
        @if (pagina > 1)
        {
            <a asp-action="Index" asp-route-reservaId="@reserva.Id" asp-route-pagina="@(pagina - 1)" asp-route-tamanio="@tamanio" class="btn btn-outline-secondary btn-sm">Anterior</a>
        }
        else
        {
            <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">Anterior</span>
        }
        @if (pagina < paginas)
        {
            <a asp-action="Index" asp-route-reservaId="@reserva.Id" asp-route-pagina="@(pagina + 1)" asp-route-tamanio="@tamanio" class="btn btn-outline-secondary btn-sm">Siguiente</a>
        }
        else
        {
            <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">Siguiente</span>
        }
    </nav>
</div>
