@model InmobiliariaGrupoNN.Models.Propietario

@{
    ViewData["Title"] = "Eliminar Propietario";
}

<h1>Dar de baja Propietario</h1>
<h3 class="text-danger">Estas seguro de que queres dar de baja a este propietario?</h3>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">DNI</dt>
        <dd class="col-sm-9">@Model.Dni</dd>
        
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>

        <dt class="col-sm-3">Apellido</dt>
        <dd class="col-sm-9">@Model.Apellido</dd>
        
        <dt class="col-sm-3">Telefono</dt>
        <dd class="col-sm-9">@Model.Telefono</dd>
        
        <dt class="col-sm-3">Correo Electronico</dt>
        <dd class="col-sm-9">@Model.Email</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Confirmar Baja" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
    </form>
</div>