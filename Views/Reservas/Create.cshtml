@model InmobiliariaGrupoNN.Models.Reserva

@{
    ViewData["Title"] = "Nueva Reserva";
}

<h2>Nueva Reserva</h2>
<hr />

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row">
    <div class="col-md-5">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <input type="hidden" asp-for="InmuebleId" />
            <div class="alert alert-info">
                <strong>Inmueble:</strong> @Model.Inmueble?.Direccion<br />
                <strong>Tipo:</strong> @Model.Inmueble?.TipoInmueble?.Nombre —
                <strong>Cupo:</strong> @Model.Inmueble?.Cupo
            </div>
            <a asp-action="BuscarDisponibilidad" asp-route-buscar="true"
               asp-route-fechaInicio="@Model.FechaInicio.ToString("yyyy-MM-dd")"
               asp-route-fechaFin="@Model.FechaFin.ToString("yyyy-MM-dd")"
               class="btn btn-outline-secondary mb-3">Elegir otro inmueble</a>
            <div class="form-group mb-3">
                <label asp-for="InquilinoId" class="control-label fw-bold">Inquilino</label>
                <select asp-for="InquilinoId" class="form-select" required>
                    <option value="">Seleccione un inquilino...</option>
                    @if(ViewBag.Inquilinos != null) {
                        foreach (var item in ViewBag.Inquilinos) {
                            <option value="@item.Id">@item.Nombre @item.Apellido</option>
                        }
                    }
                </select>
            </div>

            <div class="row mb-3">
                <div class="form-group col">
                    <label asp-for="FechaInicio" class="control-label fw-bold">Fecha Inicio</label>
                    <input asp-for="FechaInicio" type="date" class="form-control" required />
                </div>
                <div class="form-group col">
                    <label asp-for="FechaFin" class="control-label fw-bold">Fecha Fin</label>
                    <input asp-for="FechaFin" type="date" class="form-control" required />
                </div>
            </div>

            <div class="form-group mb-4">
                <label asp-for="MontoPorDia" class="control-label fw-bold">Monto por dia</label>
                <input asp-for="MontoPorDia" type="number" step="0.01" class="form-control" required />
            </div>

            <div class="alert alert-info">
                Porcentaje de seña del inmueble: <strong>@Model.Inmueble?.PorcentajeReserva.ToString("N2") %</strong>.
                Al confirmar se registrará el pago de la seña calculada sobre los días y el monto ingresados,
                con el porcentaje vigente del inmueble. Si es 0 %, no se generará un pago.
            </div>
            <div class="form-group">
                <input type="submit" value="Confirmar reserva y registrar seña" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Volver</a>
            </div>
        </form>
    </div>
</div>  