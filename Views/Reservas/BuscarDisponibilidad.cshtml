@model IList<InmobiliariaGrupoNN.Models.Inmueble>
@{
    ViewData["Title"] = "Buscar disponibilidad";
    int pagina = ViewBag.PaginaActual;
    int tamanio = ViewBag.TamanioPagina;
    int paginas = ViewBag.TotalPaginas;
}
<h2 class="mb-4">Buscar disponibilidad</h2>
<form asp-action="BuscarDisponibilidad" method="get" class="card card-body mb-4">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <input type="hidden" name="buscar" value="true" />
    <input type="hidden" name="pagina" value="1" />
    <div class="row g-3">
        <div class="col-md-3">
            <label for="fechaInicio" class="form-label">Fecha de inicio</label>
            <input id="fechaInicio" name="fechaInicio" type="date" value="@ViewBag.FechaInicio" class="form-control" required />
        </div>
        <div class="col-md-3">
            <label for="fechaFin" class="form-label">Fecha de fin</label>
            <input id="fechaFin" name="fechaFin" type="date" value="@ViewBag.FechaFin" class="form-control" required />
        </div>
        <div class="col-md-2">
            <label for="cupoMinimo" class="form-label">Cupo mínimo</label>
            <input id="cupoMinimo" name="cupoMinimo" type="number" min="1" value="@ViewBag.CupoMinimo" class="form-control" />
        </div>
        <div class="col-md-4">
            <label for="tipo" class="form-label">Tipo (opcional)</label>
            <input id="tipo" name="tipo" value="@ViewBag.Tipo" class="form-control" placeholder="Nombre del tipo de inmueble" />
        </div>
        <div class="col-md-3">
            <label for="tamanio" class="form-label">Resultados por página</label>
            <select id="tamanio" name="tamanio" class="form-select">
                @foreach (var cantidad in new[] { 5, 10, 20 })
                {
                    if (tamanio == cantidad)
                    {
                        <option value="@cantidad" selected="selected">@cantidad</option>
                    }
                    else
                    {
                        <option value="@cantidad">@cantidad</option>
                    }
                }
            </select>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-secondary">Volver a Reservas</a>
    </div>
</form>
@if (ViewBag.BusquedaRealizada == true)
{
    <p class="text-muted">@ViewBag.TotalRegistros inmuebles disponibles — Página @pagina de @paginas</p>
    <div class="table-responsive">
        <table class="table table-striped table-hover border">
            <thead class="table-dark"><tr><th>Dirección</th><th>Tipo</th><th>Cupo</th><th>Ambientes</th><th>Precio por día</th><th>Acciones</th></tr></thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted">No hay inmuebles disponibles para las fechas y filtros indicados.</td></tr>
            }
            @foreach (var inmueble in Model)
            {
                <tr>
                    <td>@inmueble.Direccion</td><td>@inmueble.TipoInmueble?.Nombre</td>
                    <td>@inmueble.Cupo</td><td>@inmueble.Ambientes</td><td>$ @inmueble.PrecioPorDia.ToString("N2")</td>
                    <td><a asp-action="Create" asp-route-inmuebleId="@inmueble.Id"
                           asp-route-fechaInicio="@ViewBag.FechaInicio" asp-route-fechaFin="@ViewBag.FechaFin"
                           class="btn btn-primary btn-sm">Reservar</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <nav aria-label="Páginas de inmuebles disponibles" class="mt-3">
        @if (pagina > 1)
        {
            <a asp-action="BuscarDisponibilidad" asp-route-buscar="true" asp-route-pagina="@(pagina - 1)"
               asp-route-tamanio="@tamanio" asp-route-fechaInicio="@ViewBag.FechaInicio" asp-route-fechaFin="@ViewBag.FechaFin"
               asp-route-cupoMinimo="@ViewBag.CupoMinimo" asp-route-tipo="@ViewBag.Tipo" class="btn btn-outline-secondary btn-sm">Anterior</a>
        }
        else
        {
            <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">Anterior</span>
        }
        @if (pagina < paginas)
        {
            <a asp-action="BuscarDisponibilidad" asp-route-buscar="true" asp-route-pagina="@(pagina + 1)"
               asp-route-tamanio="@tamanio" asp-route-fechaInicio="@ViewBag.FechaInicio" asp-route-fechaFin="@ViewBag.FechaFin"
               asp-route-cupoMinimo="@ViewBag.CupoMinimo" asp-route-tipo="@ViewBag.Tipo" class="btn btn-outline-secondary btn-sm">Siguiente</a>
        }
        else
        {
            <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">Siguiente</span>
        }
    </nav>
}
