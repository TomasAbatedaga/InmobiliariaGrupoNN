@model IEnumerable<InmobiliariaGrupoNN.Models.Reserva>

@{
    ViewData["Title"] = "Listado de Reservas";
}

<h2 class="mb-4">Gestión de Reservas</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="BuscarDisponibilidad" class="btn btn-primary">Buscar disponibilidad / Nueva Reserva</a>
    <form asp-action="Index" method="get" class="d-flex align-items-center">
        <label class="me-2 fw-bold text-muted">Mostrar:</label>
        <select name="tamanio" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
            @foreach (var cantidad in new[] { 5, 10, 20 })
            {
                if (ViewBag.TamanioPagina == cantidad)
                {
                    <option value="@cantidad" selected="selected">@cantidad filas</option>
                }
                else
                {
                    <option value="@cantidad">@cantidad filas</option>
                }
            }
        </select>
        <input type="hidden" name="pagina" value="1" />
    </form>
</div>

<table class="table table-striped table-hover border">
    <thead class="table-dark">
        <tr>
            <th>Inmueble</th>
            <th>Inquilino</th>
            <th>Inicio</th>
            <th>Fin</th>
            <th class="text-center">Estado</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center text-muted">No hay reservas registradas.</td></tr>
        }
        @foreach (var item in Model) {
            
            var hoy = DateTime.Today;
            string claseBadge = "";
            string textoEstado = "";

            if (item.FechaFin < hoy)
            {
                claseBadge = "bg-secondary";
                textoEstado = "Finalizada";
            }
            else if (item.FechaInicio <= hoy && item.FechaFin >= hoy)
            {
                claseBadge = "bg-success";
                textoEstado = "En Curso";
            }
            else
            {
                claseBadge = "bg-primary";
                textoEstado = "Futura";
            }

            <tr>
                <td class="align-middle">@item.Inmueble?.Direccion</td>
                <td class="align-middle">@item.Inquilino?.Nombre @item.Inquilino?.Apellido</td>
                <td class="align-middle">@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                <td class="align-middle">@item.FechaFin.ToString("dd/MM/yyyy")</td>
                
                <td class="align-middle text-center">
                    <span class="badge @claseBadge">@textoEstado</span>
                </td>

                <td class="align-middle">
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm px-2 text-white">Detalles</a> 
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm px-2">Editar</a> 
                        <a asp-action="Renovar" asp-route-id="@item.Id" class="btn btn-success btn-sm px-2" title="Renovar Contrato">
                            <i class="bi bi-arrow-repeat"></i> Renovar
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm px-2">Eliminar</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted">Página @ViewBag.PaginaActual de @ViewBag.TotalPaginas — @ViewBag.TotalRegistros reservas</span>
    <nav aria-label="Páginas de reservas">
        @if (ViewBag.PaginaActual > 1)
        {
            <a asp-action="Index" asp-route-pagina="@(ViewBag.PaginaActual - 1)" asp-route-tamanio="@ViewBag.TamanioPagina" class="btn btn-outline-secondary btn-sm">Anterior</a>
        }
        else
        {
            <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">Anterior</span>
        }
        @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
        {
            <a asp-action="Index" asp-route-pagina="@(ViewBag.PaginaActual + 1)" asp-route-tamanio="@ViewBag.TamanioPagina" class="btn btn-outline-secondary btn-sm">Siguiente</a>
        }
        else
        {
            <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">Siguiente</span>
        }
    </nav>
</div>