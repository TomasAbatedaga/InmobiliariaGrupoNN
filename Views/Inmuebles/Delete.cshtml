@model InmobiliariaGrupoNN.Models.Inmueble

@{
    ViewData["Title"] = "Eliminar Inmueble";
}

<h1>Dar de baja Inmueble</h1>

<h3 class="text-danger">
    ¿Estas seguro de que queres dar de baja este inmueble?
</h3>

<div>
    <hr />

    <dl class="row">

        <dt class="col-sm-3">Dirección</dt>
        <dd class="col-sm-9">@Model.Direccion</dd>

        <dt class="col-sm-3">Ambientes</dt>
        <dd class="col-sm-9">@Model.Ambientes</dd>

        <dt class="col-sm-3">Cupo Máximo</dt>
        <dd class="col-sm-9">@Model.Cupo</dd>

        <dt class="col-sm-3">Precio por Día</dt>
        <dd class="col-sm-9">$@Model.PrecioPorDia.ToString("N2")</dd>

        <dt class="col-sm-3">Propietario</dt>
        <dd class="col-sm-9">
            @Model.Propietario?.Nombre
            @Model.Propietario?.Apellido
        </dd>

        <dt class="col-sm-3">Tipo de Inmueble</dt>
        <dd class="col-sm-9">
            @Model.TipoInmueble?.Nombre
        </dd>

    </dl>

    <form asp-action="Delete">

        <input type="hidden" asp-for="Id" />

        <input type="submit"
               value="Confirmar Baja"
               class="btn btn-danger" />

        <a asp-action="Index"
           class="btn btn-secondary ms-2">
            Cancelar
        </a>

    </form>
</div>