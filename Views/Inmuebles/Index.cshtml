@model IEnumerable<InmobiliariaGrupoNN.Models.Inmueble>

@{
    ViewData["Title"] = "Listado de Inmuebles";
}

<h1>Listado de Inmuebles</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Inmueble</a>
</p>

<table class="table table-striped table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>Dirección</th>
            <th>Ambientes</th>
            <th>Cupo</th>
            <th>Precio por Día</th>
            <th>Propietario</th>
            <th>Tipo</th>
            <th>Disponible</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var inmueble in Model)
        {
            <tr>
                <td>@inmueble.Direccion</td>
                <td>@inmueble.Ambientes</td>
                <td>@inmueble.Cupo</td>
                <td>$@inmueble.PrecioPorDia.ToString("N2")</td>

                <td>
                    @inmueble.Propietario?.Nombre
                    @inmueble.Propietario?.Apellido
                </td>

                <td>
                    @inmueble.TipoInmueble?.Nombre
                </td>

                <td>
                    @if (inmueble.Disponible)
                    {
                        <span class="badge bg-success">Disponible</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">No disponible</span>
                    }
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@inmueble.Id"
                       class="btn btn-info btn-sm">
                        Detalles
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@inmueble.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@inmueble.Id"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>