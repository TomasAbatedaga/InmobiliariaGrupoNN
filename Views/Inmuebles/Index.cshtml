@model IEnumerable<InmobiliariaGrupoNN.Models.Inmueble>

@{
    ViewData["Title"] = "Listado de Inmuebles";
}

<h1 class="mb-4">Listado de Inmuebles</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Create" class="btn btn-primary">Nuevo Inmueble</a>

    <form asp-action="Index" method="get" class="d-flex align-items-center">
        <label class="me-2 fw-bold text-muted">Mostrar:</label>
        <select name="tamanio" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
            <option value="5" selected="@(ViewBag.TamanioPagina == 5 ? "selected" : null)">5 filas</option>
            <option value="10" selected="@(ViewBag.TamanioPagina == 10 ? "selected" : null)">10 filas</option>
        </select>
        <input type="hidden" name="pagina" value="@ViewBag.PaginaActual" />
    </form>
</div>

<table class="table table-striped table-hover border">
    <thead class="table-dark">
        <tr>
            <th>Foto</th>
            <th>Dirección</th>
            <th>Ambientes</th>
            <th>Cupo</th>
            <th>Precio por Día</th>
            <th>Propietario</th>
            <th>Tipo</th>
            <th>Disponible</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var inmueble in Model)
        {
            <tr>
                <td class="align-middle">
                    @if (!string.IsNullOrEmpty(inmueble.Portada))
                    {
                        <img src="@inmueble.Portada"
                             class="img-thumbnail"
                             style="width: 80px; height: 60px; object-fit: cover;" />
                    }
                    else
                    {
                        <span class="text-muted">Sin foto</span>
                    }
                </td>
                <td class="align-middle">@inmueble.Direccion</td>
                <td class="align-middle">@inmueble.Ambientes</td>
                <td class="align-middle">@inmueble.Cupo</td>
                <td class="align-middle">$@inmueble.PrecioPorDia.ToString("N2")</td>
                <td class="align-middle">@inmueble.Propietario?.Nombre @inmueble.Propietario?.Apellido</td>
                <td class="align-middle">@inmueble.TipoInmueble?.Nombre</td>
                <td class="align-middle">
                    @if (inmueble.Disponible)
                    {
                        <span class="badge bg-success">Disponible</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">No disponible</span>
                    }
                </td>
                <td class="align-middle">
                    <div class="d-flex gap-1">
                        <a asp-action="Details" asp-route-id="@inmueble.Id" class="btn btn-info btn-sm text-white">Detalles</a>
                        <a asp-action="Edit" asp-route-id="@inmueble.Id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Imagenes" asp-route-id="@inmueble.Id" class="btn btn-secondary btn-sm">Imágenes</a>
                        <a asp-action="Delete" asp-route-id="@inmueble.Id" class="btn btn-danger btn-sm">Eliminar</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted">Página @ViewBag.PaginaActual</span>
    <div>
        <a asp-action="Index" asp-route-pagina="@(ViewBag.PaginaActual - 1)" asp-route-tamanio="@ViewBag.TamanioPagina" class="btn btn-outline-secondary btn-sm @(ViewBag.PaginaActual <= 1 ? "disabled" : "")">Anterior</a>
        <a asp-action="Index" asp-route-pagina="@(ViewBag.PaginaActual + 1)" asp-route-tamanio="@ViewBag.TamanioPagina" class="btn btn-outline-secondary btn-sm">Siguiente</a>
    </div>
</div>