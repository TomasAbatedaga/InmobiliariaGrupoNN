@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <h1 class="text-danger display-1"><i class="bi bi-shield-lock"></i></h1>
        <h2 class="text-danger mb-3">Acceso Denegado</h2>
        <p class="lead">No tenes los permisos necesarios para acceder a esta seccion.</p>
        <hr />
        <p class="text-muted">Si crees que esto es un error, comunicate con el administrador del sistema.</p>
        
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Volver al Inicio</a>
    </div>
</div>