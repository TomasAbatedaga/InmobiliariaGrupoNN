@model InmobiliariaGrupoNN.Models.Usuario

@{
    ViewData["Title"] = "Nuevo Usuario";
}

<h2 class="mb-4">Registrar Nuevo Usuario</h2>
<hr />

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="row">
    <div class="col-md-5">
        <form asp-action="Create" enctype="multipart/form-data">
            
            <div class="row mb-3">
                <div class="form-group col">
                    <label asp-for="Nombre" class="control-label fw-bold"></label>
                    <input asp-for="Nombre" class="form-control" required />
                </div>
                <div class="form-group col">
                    <label asp-for="Apellido" class="control-label fw-bold"></label>
                    <input asp-for="Apellido" class="form-control" required />
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label fw-bold"></label>
                <input asp-for="Email" type="email" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Clave" class="control-label fw-bold">Contraseña</label>
                <input asp-for="Clave" type="password" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Rol" class="control-label fw-bold">Rol del Sistema</label>
                <select asp-for="Rol" asp-items="Html.GetEnumSelectList<InmobiliariaGrupoNN.Models.Rol>()" class="form-select" required>
                    <option value="">Seleccione un rol...</option>
                </select>
            </div>

            <div class="form-group mb-4">
                <label class="control-label fw-bold">Foto de Perfil (Opcional)</label>
                <input type="file" name="avatarFile" class="form-control" accept="image/*" />
            </div>

            <div class="form-group">
                <input type="submit" value="Guardar Usuario" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Volver al listado</a>
            </div>
        </form>
    </div>
</div>