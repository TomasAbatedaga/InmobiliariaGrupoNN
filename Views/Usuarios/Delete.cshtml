@model InmobiliariaGrupoNN.Models.Usuario

@{
    ViewData["Title"] = "Eliminar Usuario";
}

<h2 class="text-danger mb-4">Eliminar Usuario</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mb-4">@ViewBag.Error</div>
}

<div class="card border-danger mb-4" style="max-width: 500px;">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">¿Estás seguro de que querés eliminar este usuario?</h5>
    </div>
    <div class="card-body">
        <div class="d-flex align-items-center mb-3">
            @if (!string.IsNullOrEmpty(Model.Avatar))
            {
                <img src="@Model.Avatar" class="rounded-circle me-3" style="width: 60px; height: 60px; object-fit: cover;" />
            }
            <div>
                <h5 class="mb-0">@Model.NombreCompleto</h5>
                <p class="text-muted mb-0">@Model.Email</p>
            </div>
        </div>
        
        <p class="mb-0"><strong>Rol en el sistema:</strong> @Model.Rol</p>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Eliminar de forma permanente" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar y volver</a>
</form>