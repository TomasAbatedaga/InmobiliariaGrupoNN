@model IEnumerable<InmobiliariaGrupoNN.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<h2 class="mb-4">Usuarios del Sistema</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Create" class="btn btn-primary">Registrar Usuario</a>

    <form asp-action="Index" method="get" class="d-flex align-items-center">
        <label class="me-2 fw-bold text-muted">Mostrar:</label>
        <select name="tamanio" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
            <option value="5" selected="@(ViewBag.TamanioPagina == 5 ? "selected" : null)">5 filas</option>
            <option value="10" selected="@(ViewBag.TamanioPagina == 10 ? "selected" : null)">10 filas</option>
        </select>
        <input type="hidden" name="pagina" value="@ViewBag.PaginaActual" />
    </form>
</div>

<table class="table table-striped table-hover border">
    <thead class="table-dark">
        <tr>
            <th>Avatar</th>
            <th>Nombre Completo</th>
            <th>Email</th>
            <th>Rol</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
        <tr>
            <td class="align-middle">
                @if (!string.IsNullOrEmpty(item.Avatar))
                {
                    <img src="@item.Avatar" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" alt="Avatar" />
                }
                else
                {
                    <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 40px; height: 40px;">
                        @item.Nombre.Substring(0,1)@item.Apellido.Substring(0,1)
                    </div>
                }
            </td>
            <td class="align-middle">@item.NombreCompleto</td>
            <td class="align-middle">@item.Email</td>
            <td class="align-middle">
                <span class="badge @(item.Rol == InmobiliariaGrupoNN.Models.Rol.Administrador ? "bg-danger" : "bg-info text-dark")">
                    @item.Rol
                </span>
            </td>
            <td class="align-middle text-center">
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm px-2">Eliminar</a>
            </td>
        </tr>
        }
    </tbody>
</table>