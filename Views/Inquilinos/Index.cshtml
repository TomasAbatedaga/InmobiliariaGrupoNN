@model IEnumerable<InmobiliariaGrupoNN.Models.Inquilino>

@{
    ViewData["Title"] = "Inquilinos";
}

<h1>Listado Inquilinos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Inquilino</a>
</p>

<table class="table table-striped table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>DNI</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Telefono</th>
            <th>Email</th>
            <th>Fecha de Alta</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var inquilino in Model)
        {
            <tr>
                <td>@inquilino.Dni</td>
                <td>@inquilino.Nombre</td>
                <td>@inquilino.Apellido</td>
                <td>@inquilino.Telefono</td>
                <td>@inquilino.Email</td>
                <td>@inquilino.FechaAlta.ToString("dd/MM/yyyy")</td>
                <td>
                    @if(inquilino.EstadoActivo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Inactivo desde @(inquilino.FechaBaja?.ToString("dd/MM/yyyy") ?? "-")
                        </span>
                    }
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@inquilino.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@inquilino.Id"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>