@model IEnumerable<InmobiliariaGrupoNN.Models.Inquilino>

@{
    ViewData["Title"] = "Inquilinos";
}

<h1 class="mb-4">Listado de Inquilinos</h1>

<!-- Barra superior con botón y selector -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Create" class="btn btn-primary">Nuevo Inquilino</a>

    <form asp-action="Index" method="get" class="d-flex align-items-center">
        <label class="me-2 fw-bold text-muted">Mostrar:</label>
        <select name="tamanio" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
            <option value="5" selected="@(ViewBag.TamanioPagina == 5 ? "selected" : null)">5 filas</option>
            <option value="10" selected="@(ViewBag.TamanioPagina == 10 ? "selected" : null)">10 filas</option>
        </select>
        <input type="hidden" name="pagina" value="@ViewBag.PaginaActual" />
    </form>
</div>

<table class="table table-striped table-hover border">
    <thead class="table-dark">
        <tr>
            <th>DNI</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Telefono</th>
            <th>Email</th>
            <th>Fecha de Alta</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var inquilino in Model)
        {
            <tr>
                <td class="align-middle">@inquilino.Dni</td>
                <td class="align-middle">@inquilino.Nombre</td>
                <td class="align-middle">@inquilino.Apellido</td>
                <td class="align-middle">@inquilino.Telefono</td>
                <td class="align-middle">@inquilino.Email</td>
                <td class="align-middle">@inquilino.FechaAlta.ToString("dd/MM/yyyy")</td>
                <td class="align-middle">
                    @if(inquilino.EstadoActivo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Inactivo desde @(inquilino.FechaBaja?.ToString("dd/MM/yyyy") ?? "-")
                        </span>
                    }
                </td>
                <td class="align-middle">
                    <div class="d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@inquilino.Id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Delete" asp-route-id="@inquilino.Id" class="btn btn-danger btn-sm">Eliminar</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Controles de Paginación -->
<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted">Página @ViewBag.PaginaActual</span>
    <div>
        <a asp-action="Index" asp-route-pagina="@(ViewBag.PaginaActual - 1)" asp-route-tamanio="@ViewBag.TamanioPagina" class="btn btn-outline-secondary btn-sm @(ViewBag.PaginaActual <= 1 ? "disabled" : "")">Anterior</a>
        <a asp-action="Index" asp-route-pagina="@(ViewBag.PaginaActual + 1)" asp-route-tamanio="@ViewBag.TamanioPagina" class="btn btn-outline-secondary btn-sm">Siguiente</a>
    </div>
</div>