@model IEnumerable<InmobiliariaGrupoNN.Models.TipoInmueble>

@{
    ViewData["Title"] = "Tipos de Inmueble";
}

<h2 class="mb-4">Listado de Tipos de Inmueble</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nuevo Tipo</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id)</th>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Id)</td>
            <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a> 
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
            </td>
        </tr>
        }
    </tbody>
</table>