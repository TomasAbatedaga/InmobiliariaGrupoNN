@model IEnumerable<InmobiliariaGrupoNN.Models.TipoInmueble>

@{
    ViewData["Title"] = "Tipos de Inmueble";
}

<h2 class="mb-4">Listado de Tipos de Inmueble</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Create" class="btn btn-primary">Crear Nuevo Tipo</a>

    <form asp-action="Index" method="get" class="d-flex align-items-center">
        <label class="me-2 fw-bold text-muted">Mostrar:</label>
        <select name="tamanio" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
            <option value="5" selected="@(ViewBag.TamanioPagina == 5 ? "selected" : null)">5 filas</option>
            <option value="10" selected="@(ViewBag.TamanioPagina == 10 ? "selected" : null)">10 filas</option>
            <option value="20" selected="@(ViewBag.TamanioPagina == 20 ? "selected" : null)">20 filas</option>
        </select>
        <input type="hidden" name="pagina" value="@ViewBag.PaginaActual" />
    </form>
</div>

<table class="table table-striped table-hover border">
    <thead class="table-dark">
        <tr>
            <th style="width: 15%;">@Html.DisplayNameFor(model => model.Id)</th>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th class="text-center" style="width: 20%;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
        <tr>
            <td class="align-middle">@Html.DisplayFor(modelItem => item.Id)</td>
            <td class="align-middle">@Html.DisplayFor(modelItem => item.Nombre)</td>
            <td>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm px-3">Editar</a> 
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm px-3">Eliminar</a>
                </div>
            </td>
        </tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted">Página @ViewBag.PaginaActual</span>
    
    <div>
        <a asp-action="Index" 
           asp-route-pagina="@(ViewBag.PaginaActual - 1)" 
           asp-route-tamanio="@ViewBag.TamanioPagina" 
           class="btn btn-outline-secondary btn-sm @(ViewBag.PaginaActual <= 1 ? "disabled" : "")">
            Anterior
        </a>
        
        <a asp-action="Index" 
           asp-route-pagina="@(ViewBag.PaginaActual + 1)" 
           asp-route-tamanio="@ViewBag.TamanioPagina" 
           class="btn btn-outline-secondary btn-sm">
            Siguiente
        </a>
    </div>
</div>