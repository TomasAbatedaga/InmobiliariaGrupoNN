@model InmobiliariaGrupoNN.Models.TipoInmueble

@{
    ViewData["Title"] = "Eliminar Tipo";
}

<h2 class="text-danger">Eliminar Tipo de Inmueble</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mb-4">
        @ViewBag.Error
    </div>
}

<h3>¿Estas seguro de que queres eliminar esto?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar de forma permanente" class="btn btn-danger" /> 
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar y volver</a>
    </form>
</div>